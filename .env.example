# Server-side only (Netlify → Site configuration → Environment variables).
# Never prefix these with VITE_, never commit real values.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DATABASE_CA_CERT=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
AWS_LAMBDA_JS_RUNTIME=nodejs22.x

# Browser (public by design): used only for Supabase Auth sign-in.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local development / deploy previews only. Ignored when CONTEXT=production.
# WORKBENCH_AUTH=dev
# WORKBENCH_DB_DIR=./.local-db
